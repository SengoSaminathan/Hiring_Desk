# Hiring Desk Environment Configuration

# Server
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8001
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Google Gemini API
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Playwright Browser Automation
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_USER_DATA_DIR=./data/browser_profile

# Agent Safety Limits
MAX_TASK_STEPS=30
MAX_RECOVERY_ATTEMPTS=4

# Supabase Database Configuration
# Project URL: https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# New Supabase Key Format (or click "View legacy API keys"):
# - "Publishable key" (starts with sb_publishable_...) -> Replaces legacy anon key
# - "Secret key" (starts with sb_secret_...) -> Replaces legacy service_role key
SUPABASE_KEY=your_publishable_or_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_secret_key_here

# Optional: Direct PostgreSQL connection string (Project Settings -> Database)
# SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres
